# For Vercel, create a Postgres database from the Vercel Marketplace (Neon recommended)
# and paste its connection string here.
DATABASE_URL=

# Use a long random secret (32+ characters). Do not commit a real secret.
SESSION_SECRET=

# Required only for first initialization of the production database on Vercel.
# Use a unique password; never use the local demo password there.
INITIAL_ADMIN_PASSWORD=

# Local-only defaults. The server binds to localhost unless HOST is changed.
HOST=127.0.0.1
PORT=4173
